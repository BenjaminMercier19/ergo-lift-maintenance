---
// Decorative exploded-view diagram: an olympic bar that comes apart on
// scroll (desktop only — see [data-barbell] handling in animations.ts).
// Pieces are authored in their assembled position; JS adds the explode
// offset as an absolute transform, so no-JS / reduced-motion / mobile all
// fall back to a normal, fully assembled bar.
---

<section style="background:var(--soft);padding:6rem 1.5rem;overflow:hidden;">
  <div data-reveal data-barbell style="max-width:1100px;margin:0 auto;text-align:center;">
    <h2 class="display" style="font-size:clamp(1.75rem,4vw,2.5rem);margin:0 0 0.75rem;">Jusqu'à la moindre pièce</h2>
    <p style="max-width:52ch;margin:0 auto 3rem;color:var(--charcoal);font-size:1.05rem;line-height:1.6;">Chaque réparation commence par un démontage complet : bar, manchons, colliers et disques, inspectés un par un avant remontage.</p>

    <svg viewBox="0 0 1200 380" role="img" aria-label="Schéma d'une barre olympique démontée en ses différentes pièces" style="width:100%;max-width:820px;height:auto;overflow:visible;">
      <rect x="280" y="177" width="640" height="26" rx="13" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />

      <g data-piece data-x="-230" data-y="25">
        <circle cx="95" cy="212" r="84" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
        <circle cx="95" cy="212" r="13" fill="var(--soft)" />
      </g>
      <g data-piece data-x="230" data-y="25">
        <circle cx="1105" cy="212" r="84" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
        <circle cx="1105" cy="212" r="13" fill="var(--soft)" />
      </g>

      <g data-piece data-x="-170" data-y="-25">
        <circle cx="158" cy="172" r="60" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
        <circle cx="158" cy="172" r="11" fill="var(--soft)" />
      </g>
      <g data-piece data-x="170" data-y="-25">
        <circle cx="1042" cy="172" r="60" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
        <circle cx="1042" cy="172" r="11" fill="var(--soft)" />
      </g>

      <g data-piece data-x="-140" data-y="-10">
        <rect x="185" y="157" width="18" height="66" rx="4" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
      </g>
      <g data-piece data-x="140" data-y="-10">
        <rect x="997" y="157" width="18" height="66" rx="4" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
      </g>

      <g data-piece data-x="-90" data-y="0">
        <rect x="210" y="163" width="80" height="54" rx="10" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
      </g>
      <g data-piece data-x="90" data-y="0">
        <rect x="910" y="163" width="80" height="54" rx="10" fill="var(--ink)" stroke="var(--soft)" stroke-width="5" />
      </g>
    </svg>
  </div>
</section>
