---
// Design read: B2B service landing, radical-subtraction engineering language,
// Tesla-style full-viewport photography, near-zero chrome, single blue accent.
// Dials: VARIANCE 5 / MOTION 3 / DENSITY 2.
import '@fontsource/manrope/300.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import heroImg from '../../assets/photos/hero.jpg';
import bandImg from '../../assets/photos/audit-bikeerg-diagnostic.jpg';
import {
  nav, hero, services, contact, testimonial, social, legal,
} from '../../data/content';

const blue = '#3E6AE1';
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ergo&Lift Maintenance · Tesla</title>
  <style define:vars={{ blue }}>
    :root {
      --blue: var(--blue);
      --ink: #171a20;
      --ink-soft: #5c5e62;
      --canvas: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font-family: 'Manrope', system-ui, sans-serif;
      font-weight: 400;
      -webkit-font-smoothing: antialiased;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 0.85rem 2rem;
      background: var(--blue);
      color: #fff;
      border-radius: 4px;
      font-weight: 500;
      font-size: 0.95rem;
      text-decoration: none;
      white-space: nowrap;
      transition: filter 0.2s;
    }
    .btn:hover { filter: brightness(1.1); }
    .btn:active { transform: scale(0.98); }
    .link {
      color: var(--ink);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      transition: opacity 0.15s;
    }
    .link:hover { opacity: 0.65; }
    #services { scroll-margin-top: 64px; }
    @media (prefers-reduced-motion: reduce) { .btn, .link { transition: none; } }
  </style>
</head>
<body>
  <a href="/" style="position:fixed;top:76px;left:0.75rem;z-index:50;background:#171a20;color:#fff;font-size:0.75rem;padding:0.4rem 0.75rem;border-radius:4px;text-decoration:none;">← Comparatif</a>

  <header style="position:fixed;top:0;left:0;right:0;z-index:40;height:64px;display:flex;align-items:center;background:rgba(255,255,255,0.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);">
    <div style="max-width:1400px;margin:0 auto;width:100%;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-weight:600;letter-spacing:0.02em;font-size:1.1rem;">ERGO&amp;LIFT</span>
      <nav style="display:flex;align-items:center;gap:2.25rem;">
        {nav.map((item) => (<a href={item.href} class="link">{item.label}</a>))}
      </nav>
    </div>
  </header>

  <section style="position:relative;height:100dvh;display:flex;align-items:flex-end;justify-content:center;overflow:hidden;">
    <Image src={heroImg} alt="Équipe Ergo&Lift en intervention" width={1920} height={1280} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" priority />
    <div style="position:absolute;inset:0;background:linear-gradient(0deg, rgba(255,255,255,0.96) 0%, rgba(255,255,255,0.55) 30%, transparent 55%);"></div>
    <div style="position:relative;max-width:640px;text-align:center;padding:0 1.5rem 4.5rem;">
      <h1 style="font-weight:300;font-size:clamp(1.9rem,4.2vw,2.75rem);line-height:1.2;margin:0 0 1rem;color:var(--ink);">{hero.headline}</h1>
      <p style="font-size:1rem;color:var(--ink-soft);max-width:42ch;margin:0 auto 1.75rem;line-height:1.5;">{hero.subheadline}</p>
      <div style="display:flex;gap:0.9rem;justify-content:center;flex-wrap:wrap;">
        <a href={contact.phoneHref} class="btn">{hero.ctaPrimary}</a>
        <a href="#services" class="link" style="align-self:center;">{hero.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <section id="services" style="max-width:1100px;margin:0 auto;padding:7rem 1.5rem;">
    <div class="services-row" style="display:grid;grid-template-columns:repeat(3,1fr);">
      {services.map((s, i) => (
        <div style={`padding:0 2rem;${i > 0 ? 'border-left:1px solid #e5e5e7;' : ''}`}>
          <Icon name={s.icon} style={`width:1.75rem;height:1.75rem;color:${blue};margin-bottom:1rem;`} />
          <h3 style="font-weight:600;font-size:1.15rem;margin:0 0 0.6rem;">{s.title}</h3>
          <p style="color:var(--ink-soft);font-size:0.92rem;line-height:1.5;margin:0;">{s.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="position:relative;height:70dvh;overflow:hidden;display:flex;align-items:center;justify-content:center;">
    <Image src={bandImg} alt="Diagnostic technique d'un BikeErg" width={1920} height={1200} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
    <div style="position:absolute;inset:0;background:rgba(23,26,32,0.35);"></div>
    <p style="position:relative;color:#fff;font-weight:300;font-size:clamp(2rem,6vw,4rem);margin:0;">Sous 48h</p>
  </section>

  <section style="max-width:800px;margin:0 auto;padding:7rem 1.5rem;text-align:center;">
    {testimonial.pending ? (
      <p style="color:var(--ink-soft);font-size:1rem;">Nos premiers avis Google arrivent bientôt.</p>
    ) : (
      <blockquote style="font-weight:300;font-size:1.5rem;line-height:1.5;margin:0;">"{testimonial.quote}"<footer style="margin-top:1rem;font-size:0.9rem;color:var(--ink-soft);">{testimonial.author}</footer></blockquote>
    )}
    <a href={social.googleReview} class="link" style={`color:${blue};display:inline-block;margin-top:1rem;`}>Voir la fiche Google</a>
  </section>

  <section style="text-align:center;padding:2rem 1.5rem 7rem;">
    <a href={contact.phoneHref} class="btn">{hero.ctaPrimary}</a>
    <p style="margin-top:1.25rem;color:var(--ink-soft);font-size:0.9rem;">
      <a href={contact.phoneHref} class="link" style="color:inherit;">{contact.phone}</a>
      {' · '}
      <a href={`mailto:${contact.email}`} class="link" style="color:inherit;">{contact.email}</a>
    </p>
  </section>

  <footer style="border-top:1px solid #e5e5e7;padding:2rem 1.5rem;">
    <div style="max-width:1400px;margin:0 auto;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;font-size:0.82rem;color:var(--ink-soft);">
      <span>ERGO&amp;LIFT MAINTENANCE</span>
      <div style="display:flex;gap:1.5rem;flex-wrap:wrap;">
        {nav.map((item) => (<a href={item.href} class="link" style="color:var(--ink-soft);text-decoration:none;font-size:0.82rem;font-weight:400;">{item.label}</a>))}
        <a href="/mentions-legales" class="link" style="color:var(--ink-soft);text-decoration:none;font-size:0.82rem;font-weight:400;">Mentions légales</a>
        <a href="/cgv" class="link" style="color:var(--ink-soft);text-decoration:none;font-size:0.82rem;font-weight:400;">CGV</a>
      </div>
      <div style="display:flex;gap:0.9rem;">
        <a href={social.instagram} aria-label="Instagram" style="color:var(--ink-soft);"><Icon name="simple-icons:instagram" style="width:1.1rem;height:1.1rem;" /></a>
        <a href={social.linkedin} aria-label="LinkedIn" style="color:var(--ink-soft);"><Icon name="simple-icons:linkedin" style="width:1.1rem;height:1.1rem;" /></a>
      </div>
      <span>{legal.copyright}</span>
    </div>
  </footer>

  <style>
    @media (max-width: 768px) {
      .services-row { grid-template-columns: 1fr !important; gap: 2.5rem; }
      .services-row > div { border-left: none !important; padding: 0 !important; }
    }
  </style>
</body>
</html>
