---
// Design read: B2B technical-feeling service landing, stark ink-on-near-white
// minimalist language, Vercel-style hairline borders + mono captions.
// Dials: VARIANCE 6 / MOTION 4 / DENSITY 4.
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/jetbrains-mono/500.css';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import heroImg from '../../assets/photos/hero.jpg';
import serviceImg from '../../assets/photos/entretien-skierg-cordes.jpg';
import {
  nav, hero, services, serviceTag, contact, serviceArea, testimonial, social, legal,
} from '../../data/content';
import { withBase } from '../../utils/url';
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ergo&Lift Maintenance · Vercel</title>
  <style>
    :root {
      --ink: #171717;
      --body: #4d4d4d;
      --mute: #888888;
      --hairline: #ebebeb;
      --canvas: #ffffff;
      --canvas-soft: #fafafa;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font-family: 'Geist Sans', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 0.7rem 1.4rem;
      background: var(--ink);
      color: #fff;
      border-radius: 6px;
      font-weight: 500;
      font-size: 0.9rem;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s;
    }
    .btn:hover { background: #000; }
    .btn:active { transform: scale(0.98); }
    .btn-outline {
      display: inline-flex;
      align-items: center;
      padding: 0.7rem 1.4rem;
      border: 1px solid var(--hairline);
      border-radius: 6px;
      color: var(--ink);
      font-weight: 500;
      font-size: 0.9rem;
      text-decoration: none;
      white-space: nowrap;
      transition: border-color 0.15s;
    }
    .btn-outline:hover { border-color: #c9c9c9; }
    .card { border: 1px solid var(--hairline); border-radius: 8px; }
    .navlink { transition: color 0.15s; }
    .navlink:hover { color: var(--ink); }
    #services { scroll-margin-top: 64px; }
    @media (prefers-reduced-motion: reduce) { .btn, .btn-outline, .navlink { transition: none; } }
  </style>
</head>
<body>
  <a href={withBase('/')} style="position:fixed;top:0.75rem;left:0.75rem;z-index:50;background:#171717;color:#fff;font-size:0.75rem;padding:0.4rem 0.75rem;border-radius:6px;text-decoration:none;">← Comparatif</a>

  <header style="position:sticky;top:0;z-index:40;background:rgba(255,255,255,0.85);backdrop-filter:blur(8px);border-bottom:1px solid var(--hairline);height:64px;display:flex;align-items:center;">
    <div style="max-width:1200px;margin:0 auto;width:100%;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;">
      <span style="font-weight:700;font-size:1.05rem;">Ergo&amp;Lift</span>
      <nav style="display:flex;align-items:center;gap:1.75rem;">
        {nav.map((item) => (<a href={withBase(item.href)} class="navlink" style="color:var(--body);text-decoration:none;font-size:0.9rem;font-weight:500;">{item.label}</a>))}
        <a href={contact.phoneHref} class="btn">Demander un devis</a>
      </nav>
    </div>
  </header>

  <section style="max-width:1200px;margin:0 auto;padding:5rem 1.5rem;display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;" class="hero-grid">
    <div>
      <h1 style="font-size:clamp(2.25rem,4vw,3.25rem);font-weight:700;line-height:1.12;letter-spacing:-0.02em;margin:0 0 1.1rem;">{hero.headline}</h1>
      <p style="color:var(--body);font-size:1.05rem;line-height:1.55;max-width:42ch;margin:0 0 1.75rem;">{hero.subheadline}</p>
      <div style="display:flex;gap:0.85rem;flex-wrap:wrap;">
        <a href={contact.phoneHref} class="btn" style="padding:0.85rem 1.6rem;">{hero.ctaPrimary}</a>
        <a href="#services" class="btn-outline" style="padding:0.85rem 1.6rem;">{hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="card" style="overflow:hidden;aspect-ratio:4/3;">
      <Image src={heroImg} alt="Équipe Ergo&Lift en intervention sur des rameurs Concept 2" width={1200} height={900} style="width:100%;height:100%;object-fit:cover;" priority />
    </div>
  </section>

  <section id="services" style="max-width:1200px;margin:0 auto;padding:0 1.5rem 5rem;">
    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:1.25rem;" class="services-grid">
      <div class="card" style="padding:2rem;">
        <Icon name={services[0].icon} style="width:1.6rem;height:1.6rem;color:var(--ink);margin-bottom:1rem;" />
        <h3 style="font-size:1.2rem;font-weight:600;margin:0 0 0.5rem;">{services[0].title}</h3>
        <p style="color:var(--body);font-size:0.92rem;line-height:1.5;margin:0 0 1rem;">{services[0].description}</p>
        <span class="mono" style="font-size:0.75rem;color:var(--mute);text-transform:uppercase;letter-spacing:0.05em;">{serviceTag}</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:1.25rem;">
        {services.slice(1).map((s) => (
          <div class="card" style="padding:1.5rem;flex:1;">
            <Icon name={s.icon} style="width:1.4rem;height:1.4rem;color:var(--ink);margin-bottom:0.75rem;" />
            <h3 style="font-size:1.05rem;font-weight:600;margin:0 0 0.4rem;">{s.title}</h3>
            <p style="color:var(--body);font-size:0.88rem;line-height:1.5;margin:0;">{s.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="max-width:1200px;margin:0 auto;padding:0 1.5rem 5rem;">
    <div class="card photo-grid" style="display:grid;grid-template-columns:1fr 1fr;overflow:hidden;">
      <Image src={serviceImg} alt="Nettoyage des cordes d'un SkiErg" width={900} height={700} style="width:100%;height:100%;object-fit:cover;" />
      <div style="padding:2.5rem;display:flex;flex-direction:column;justify-content:center;">
        <h3 style="font-size:1.3rem;font-weight:600;margin:0 0 0.75rem;">Un travail de précision, sur site</h3>
        <p style="color:var(--body);font-size:0.95rem;line-height:1.6;margin:0;">Roulements, cordes, freins à air : chaque pièce d'usure est inspectée et traitée directement dans votre salle, sans immobilisation longue durée.</p>
      </div>
    </div>
  </section>

  <section style="max-width:800px;margin:0 auto;padding:0 1.5rem 5rem;">
    <div class="card" style="padding:2.5rem;text-align:center;">
      <span class="mono" style="font-size:0.75rem;color:var(--mute);text-transform:uppercase;letter-spacing:0.05em;">Avis Google</span>
      {testimonial.pending ? (
        <p style="color:var(--body);margin-top:0.75rem;">Nos premiers avis arrivent bientôt.</p>
      ) : (
        <blockquote style="font-size:1.15rem;line-height:1.5;margin:0.75rem 0 0;">"{testimonial.quote}"<footer style="margin-top:0.75rem;font-size:0.85rem;color:var(--mute);">{testimonial.author}</footer></blockquote>
      )}
      <a href={social.googleReview} class="btn-outline" style="margin-top:1.25rem;">Voir la fiche Google</a>
    </div>
  </section>

  <section style="background:var(--ink);padding:5rem 1.5rem;">
    <div style="max-width:800px;margin:0 auto;text-align:center;color:#fff;">
      <h2 style="font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:700;margin:0 0 1.25rem;">Une question avant de commencer ?</h2>
      <div style="display:flex;gap:0.85rem;justify-content:center;flex-wrap:wrap;">
        <a href={contact.phoneHref} class="btn" style="background:#fff;color:var(--ink);">Appeler {contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="btn-outline" style="border-color:rgba(255,255,255,0.3);color:#fff;">{contact.email}</a>
      </div>
    </div>
  </section>

  <footer style="border-top:1px solid var(--hairline);padding:3rem 1.5rem 2rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:2rem;">
        {serviceArea.map((z) => (
          <span class="mono" style="background:var(--canvas-soft);border:1px solid var(--hairline);border-radius:6px;padding:0.3rem 0.7rem;font-size:0.72rem;color:var(--body);">{z}</span>
        ))}
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;align-items:center;font-size:0.82rem;color:var(--mute);border-top:1px solid var(--hairline);padding-top:1.5rem;">
        <span>{legal.copyright}</span>
        <div style="display:flex;gap:1.25rem;flex-wrap:wrap;">
          <a href={withBase('/mentions-legales')} class="navlink" style="color:var(--mute);text-decoration:none;">Mentions légales</a>
          <a href={withBase('/cgv')} class="navlink" style="color:var(--mute);text-decoration:none;">CGV</a>
          <a href={social.instagram} aria-label="Instagram" style="color:var(--mute);"><Icon name="simple-icons:instagram" style="width:1rem;height:1rem;" /></a>
          <a href={social.linkedin} aria-label="LinkedIn" style="color:var(--mute);"><Icon name="simple-icons:linkedin" style="width:1rem;height:1rem;" /></a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 768px) {
      .hero-grid { grid-template-columns: 1fr !important; }
      .services-grid { grid-template-columns: 1fr !important; }
      .photo-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</body>
</html>
