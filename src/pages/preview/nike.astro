---
// Design read: B2B mobile service landing for CrossFit gym owners, athletic
// photography-first language, Nike-style black/white contrast + pill CTAs.
// Dials: VARIANCE 7 / MOTION 4 / DENSITY 3.
import '@fontsource/bebas-neue';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/700.css';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import heroImg from '../../assets/photos/hero.jpg';
import serviceImg from '../../assets/photos/entretien-skierg-cordes.jpg';
import bandImg from '../../assets/photos/intervention-banner.jpg';
import {
  nav, hero, services, serviceTag, equipment, contact, serviceArea, testimonial, social, legal,
} from '../../data/content';
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ergo&Lift Maintenance · Nike</title>
  <style>
    :root {
      --ink: #111111;
      --canvas: #ffffff;
      --soft: #f5f5f5;
      --charcoal: #39393b;
      --mute: #707072;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font-family: 'Archivo', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .display {
      font-family: 'Bebas Neue', 'Archivo', system-ui, sans-serif;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      line-height: 0.95;
    }
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.9rem 1.75rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.95rem;
      white-space: nowrap;
      transition: transform 0.2s cubic-bezier(0.16,1,0.3,1), background 0.2s;
    }
    .pill:active { transform: scale(0.97); }
    .pill-solid { background: var(--ink); color: #fff; }
    .pill-solid:hover { background: var(--charcoal); }
    .pill-ghost { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.7); }
    .pill-ghost:hover { border-color: #fff; }
    .pill-ghost-dark { background: transparent; color: var(--ink); border: 1.5px solid var(--ink); }
    .pill-ghost-dark:hover { background: var(--ink); color: #fff; }
    @media (prefers-reduced-motion: reduce) {
      .pill { transition: none; }
    }
    .navlink { transition: opacity 0.15s; }
    .navlink:hover { opacity: 0.6; }
    #services { scroll-margin-top: 72px; }
    @media (prefers-reduced-motion: reduce) { .navlink { transition: none; } }
  </style>
</head>
<body>
  <a href="/" style="position:fixed;top:84px;left:0.75rem;z-index:50;background:#111;color:#fff;font-size:0.75rem;padding:0.4rem 0.75rem;border-radius:999px;text-decoration:none;">← Comparatif</a>

  <header style="position:sticky;top:0;z-index:40;background:#fff;height:72px;display:flex;align-items:center;">
    <div style="max-width:1400px;margin:0 auto;width:100%;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;">
      <span class="display" style="font-size:1.5rem;">Ergo&amp;Lift</span>
      <nav style="display:flex;align-items:center;gap:2rem;">
        {nav.map((item) => (
          <a href={item.href} class="navlink" style="color:var(--ink);text-decoration:none;font-weight:500;font-size:0.95rem;">{item.label}</a>
        ))}
        <a href={contact.phoneHref} class="pill pill-ghost-dark" style="padding:0.6rem 1.25rem;font-size:0.85rem;">Appeler</a>
      </nav>
    </div>
  </header>

  <section style="position:relative;min-height:100dvh;display:flex;align-items:flex-end;overflow:hidden;">
    <Image src={heroImg} alt="Équipe Ergo&Lift en intervention sur des rameurs Concept 2" width={1920} height={1280} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" priority />
    <div style="position:absolute;inset:0;background:linear-gradient(0deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.35) 45%, rgba(0,0,0,0.1) 70%, transparent 100%);"></div>
    <div style="position:relative;max-width:1400px;margin:0 auto;width:100%;padding:0 1.5rem 4rem;color:#fff;">
      <h1 class="display" style="font-size:clamp(2.5rem, 5.5vw, 4.25rem);max-width:26ch;margin:0 0 1rem;">{hero.headline}</h1>
      <p style="max-width:46ch;font-size:1.1rem;line-height:1.5;color:rgba(255,255,255,0.9);margin:0 0 1.75rem;">{hero.subheadline}</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href={contact.phoneHref} class="pill pill-solid">{hero.ctaPrimary}</a>
        <a href="#services" class="pill pill-ghost">{hero.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <section id="services" style="max-width:1400px;margin:0 auto;padding:5rem 1.5rem;">
    <div style="display:grid;grid-template-columns:1fr;gap:1rem;" class="services-grid">
      <a href="/entretien" style="grid-column:span 2;position:relative;min-height:22rem;border-radius:4px;overflow:hidden;text-decoration:none;color:#fff;display:flex;align-items:flex-end;">
        <Image src={serviceImg} alt="Nettoyage des cordes d'un SkiErg" width={1400} height={900} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
        <div style="position:absolute;inset:0;background:linear-gradient(0deg, rgba(0,0,0,0.85), transparent 60%);"></div>
        <div style="position:relative;padding:2rem;">
          <Icon name="ph:wrench" style="width:2rem;height:2rem;color:#fff;margin-bottom:0.75rem;" />
          <h3 class="display" style="font-size:2rem;margin:0 0 0.5rem;">{services[0].title}</h3>
          <p style="max-width:40ch;color:rgba(255,255,255,0.9);margin:0;">{services[0].description}</p>
        </div>
      </a>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;grid-column:span 2;" class="services-sub">
        {services.slice(1).map((s) => (
          <div style="background:var(--soft);border-radius:4px;padding:2rem;">
            <Icon name={s.icon} style="width:1.75rem;height:1.75rem;color:var(--ink);margin-bottom:0.75rem;" />
            <h3 class="display" style="font-size:1.5rem;margin:0 0 0.5rem;">{s.title}</h3>
            <p style="color:var(--charcoal);margin:0;font-size:0.95rem;">{s.description}</p>
          </div>
        ))}
      </div>
    </div>
    <p style="margin-top:1.5rem;font-weight:700;font-size:0.95rem;">{serviceTag}</p>
  </section>

  <section style="background:var(--ink);color:#fff;padding:2.5rem 1.5rem;">
    <div style="max-width:1400px;margin:0 auto;display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;justify-content:center;">
      {equipment.map((e) => (
        <span style="border:1px solid rgba(255,255,255,0.3);border-radius:999px;padding:0.5rem 1.1rem;font-size:0.85rem;font-weight:500;">{e}</span>
      ))}
    </div>
  </section>

  <section style="max-width:900px;margin:0 auto;padding:6rem 1.5rem;text-align:center;">
    <h2 class="display" style="font-size:2.25rem;margin:0 0 1rem;">Ce que nos clients en disent</h2>
    {testimonial.pending ? (
      <p style="color:var(--mute);font-size:1.05rem;">Nos premiers avis arrivent bientôt. Découvrez notre fiche Google en attendant.</p>
    ) : (
      <blockquote style="font-size:1.35rem;line-height:1.5;">"{testimonial.quote}"<footer style="margin-top:1rem;font-size:0.95rem;color:var(--mute);">{testimonial.author}</footer></blockquote>
    )}
    <a href={social.googleReview} class="pill pill-ghost-dark" style="margin-top:1.5rem;">
      <Icon name="ph:star" style="width:1rem;height:1rem;" />
      Voir la fiche Google
    </a>
  </section>

  <section style="position:relative;padding:6rem 1.5rem;overflow:hidden;">
    <Image src={bandImg} alt="Intervention Ergo&Lift en salle" width={1920} height={900} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.6);"></div>
    <div style="position:relative;max-width:1400px;margin:0 auto;text-align:center;color:#fff;">
      <h2 class="display" style="font-size:clamp(2rem,5vw,3.5rem);margin:0 0 1.5rem;">Prêt à passer à l'action ?</h2>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href={contact.phoneHref} class="pill pill-solid">Appeler {contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="pill pill-ghost">Envoyer un email</a>
      </div>
    </div>
  </section>

  <footer style="background:var(--soft);padding:3rem 1.5rem 2rem;">
    <div style="max-width:1400px;margin:0 auto;">
      <div style="display:flex;flex-wrap:wrap;gap:2rem;justify-content:space-between;margin-bottom:2rem;">
        <div>
          <span class="display" style="font-size:1.35rem;">Ergo&amp;Lift Maintenance</span>
          <p style="color:var(--mute);font-size:0.9rem;max-width:32ch;margin-top:0.5rem;">Entretien mobile d'ergomètres Concept 2 et de barres olympiques en Île-de-France.</p>
        </div>
        <div style="display:flex;gap:3rem;flex-wrap:wrap;">
          <div>
            <p style="font-weight:700;font-size:0.85rem;margin:0 0 0.75rem;">Contact</p>
            <a href={contact.phoneHref} style="display:block;color:var(--charcoal);text-decoration:none;font-size:0.9rem;margin-bottom:0.35rem;">{contact.phone}</a>
            <a href={`mailto:${contact.email}`} style="display:block;color:var(--charcoal);text-decoration:none;font-size:0.9rem;">{contact.email}</a>
          </div>
          <div>
            <p style="font-weight:700;font-size:0.85rem;margin:0 0 0.75rem;">Suivez-nous</p>
            <div style="display:flex;gap:0.75rem;">
              <a href={social.instagram} aria-label="Instagram" style="color:var(--ink);"><Icon name="simple-icons:instagram" style="width:1.25rem;height:1.25rem;" /></a>
              <a href={social.linkedin} aria-label="LinkedIn" style="color:var(--ink);"><Icon name="simple-icons:linkedin" style="width:1.25rem;height:1.25rem;" /></a>
            </div>
          </div>
        </div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem;">
        {serviceArea.map((z) => (
          <span style="background:#fff;border-radius:999px;padding:0.35rem 0.85rem;font-size:0.78rem;color:var(--charcoal);">{z}</span>
        ))}
      </div>
      <div style="border-top:1px solid rgba(0,0,0,0.1);padding-top:1.5rem;display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;font-size:0.8rem;color:var(--mute);">
        <span>{legal.copyright}</span>
        <div style="display:flex;gap:1.5rem;">
          <a href="/mentions-legales" class="navlink" style="color:var(--mute);">Mentions légales</a>
          <a href="/cgv" class="navlink" style="color:var(--mute);">CGV</a>
        </div>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 768px) {
      .services-grid > a { grid-column: span 1 !important; }
      .services-sub { grid-column: span 1 !important; grid-template-columns: 1fr !important; }
    }
  </style>
</body>
</html>
