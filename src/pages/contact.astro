---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import NikeLayout from '../layouts/NikeLayout.astro';
import sideImg from '../assets/photos/audit-bikeerg-diagnostic.jpg';
import { contact, serviceArea } from '../data/content';

const prefilledEmail = `mailto:${contact.email}?subject=${encodeURIComponent('Demande de devis')}`;
---

<NikeLayout
  title="Contact"
  description="Contactez Ergo&Lift Maintenance pour une demande de devis d'entretien ou de réparation d'ergomètres Concept 2 en Île-de-France."
>
  <section style="max-width:1400px;margin:0 auto;padding:5rem 1.5rem 6rem;">
    <div data-hero-in>
      <h1 class="display" style="font-size:clamp(2.25rem,5vw,3.5rem);margin:0 0 1rem;">Parlons de votre salle</h1>
      <p style="max-width:55ch;font-size:1.05rem;line-height:1.6;color:var(--charcoal);margin:0 0 2.5rem;">Un appel ou un email suffit pour lancer une demande de devis gratuit. On vous répond sous 24h.</p>
    </div>

    <div style="display:grid;grid-template-columns:1.1fr 0.9fr;gap:4rem;align-items:start;" class="contact-layout">
      <div>
        <div data-reveal-group style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;" class="contact-grid">
          <a href={contact.phoneHref} style="background:var(--ink);color:#fff;border-radius:4px;padding:2rem;text-decoration:none;display:block;">
            <Icon name="ph:phone" style="width:1.75rem;height:1.75rem;margin-bottom:0.85rem;" aria-hidden="true" />
            <p style="font-weight:700;font-size:0.85rem;margin:0 0 0.5rem;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.6);">Téléphone</p>
            <p class="display" style="font-size:1.6rem;margin:0;">{contact.phone}</p>
          </a>
          <a href={prefilledEmail} style="background:var(--soft);border-radius:4px;padding:2rem;text-decoration:none;color:var(--ink);display:block;">
            <Icon name="ph:envelope" style="width:1.75rem;height:1.75rem;margin-bottom:0.85rem;" aria-hidden="true" />
            <p style="font-weight:700;font-size:0.85rem;margin:0 0 0.5rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--mute);">Email</p>
            <p class="display" style="font-size:1.3rem;margin:0;word-break:break-word;">{contact.email}</p>
          </a>
        </div>

        <p style="color:var(--mute);font-size:0.85rem;margin-top:1.5rem;">{contact.responseTime}. Un formulaire de demande de devis en ligne arrive bientôt.</p>

        <div data-reveal style="margin-top:2.5rem;padding-top:2rem;border-top:1px solid rgba(0,0,0,0.1);">
          <p style="font-weight:700;font-size:0.85rem;margin:0 0 1rem;">Zone d'intervention</p>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            {serviceArea.map((z) => (
              <span style="background:var(--soft);border-radius:999px;padding:0.4rem 0.9rem;font-size:0.85rem;color:var(--charcoal);">{z}</span>
            ))}
          </div>
        </div>
      </div>

      <div data-reveal class="contact-photo" style="border-radius:4px;overflow:hidden;position:sticky;top:6rem;">
        <Image src={sideImg} alt="Audit technique d'un parc machine par Ergo&Lift Maintenance" widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 500px" style="width:100%;height:100%;object-fit:cover;aspect-ratio:4/5;" />
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .contact-grid { grid-template-columns: 1fr !important; }
    }
    @media (max-width: 900px) {
      .contact-layout { grid-template-columns: 1fr !important; }
      .contact-photo { position: static !important; height: 16rem; }
      .contact-photo img { aspect-ratio: auto !important; }
    }
  </style>
</NikeLayout>
