---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import NikeLayout from '../layouts/NikeLayout.astro';
import bandImg from '../assets/photos/intervention-banner.jpg';
import heroPosterImg from '../assets/photos/entretien-skierg-cordes.jpg';
import { reparationPage, pricing, contact, serviceTag } from '../data/content';
import { withBase } from '../utils/url';
---

<NikeLayout
  title="Réparation"
  description="Réparation mobile d'ergomètres Concept 2 et de barres olympiques en Île-de-France : diagnostic gratuit, devis avant intervention, réparation sous 48h."
>
  <section style="position:relative;min-height:88svh;display:flex;align-items:center;overflow:hidden;background:#060606;">
    <Image src={heroPosterImg} alt="" widths={[640, 960, 1280, 1920]} sizes="100vw" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%;filter:saturate(.5) contrast(1.06) brightness(.55);" priority />
    <video data-hero-video hidden muted loop playsinline preload="none" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%;filter:saturate(.5) contrast(1.06) brightness(.55);">
      <source src={`${withBase('/media/hero-reparation.mp4')}#t=8`} type="video/mp4" />
    </video>
    <div style="position:absolute;inset:0;background:linear-gradient(100deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.6) 42%, rgba(0,0,0,0.3) 74%, rgba(0,0,0,0.55) 100%);"></div>
    <div data-hero-in style="position:relative;max-width:1400px;margin:0 auto;width:100%;padding:0 1.5rem;color:#fff;">
      <h1 class="display" style="font-size:clamp(2.25rem,5vw,3.5rem);max-width:20ch;margin:0 0 1rem;">{reparationPage.heading}</h1>
      <p style="max-width:60ch;font-size:1.05rem;line-height:1.6;color:rgba(255,255,255,0.85);margin:0;">{reparationPage.intro}</p>
    </div>
  </section>

  <section style="position:relative;height:40vh;min-height:20rem;overflow:hidden;">
    <Image src={bandImg} alt="Intervention Ergo&Lift en salle" widths={[640, 960, 1280, 1920]} sizes="100vw" style="position:absolute;top:-12%;left:0;width:100%;height:124%;object-fit:cover;" data-parallax />
  </section>

  <section style="max-width:1400px;margin:0 auto;padding:4rem 1.5rem;">
    <div data-reveal-group style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;" class="includes-grid">
      {reparationPage.includes.map((item) => (
        <div style="background:var(--soft);border-radius:4px;padding:2rem;">
          <Icon name={item.icon} style="width:1.75rem;height:1.75rem;color:var(--ink);margin-bottom:0.75rem;" aria-hidden="true" />
          <h2 class="display" style="font-size:1.4rem;margin:0 0 0.5rem;">{item.title}</h2>
          <p style="color:var(--charcoal);margin:0;font-size:0.95rem;">{item.description}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:1.5rem;font-weight:700;font-size:0.95rem;">{serviceTag}</p>
  </section>

  <section style="max-width:900px;margin:0 auto;padding:0 1.5rem 5rem;">
    <div data-reveal style="border:1px solid rgba(0,0,0,0.1);border-radius:4px;padding:2rem;display:flex;flex-wrap:wrap;gap:2rem;justify-content:space-around;text-align:center;">
      <div>
        <p class="display" style="font-size:1.75rem;margin:0;">{pricing.repair}</p>
        <p style="color:var(--mute);font-size:0.85rem;margin:0.25rem 0 0;">Main d'œuvre</p>
      </div>
      <div>
        <p class="display" style="font-size:1.75rem;margin:0;">{pricing.delay}</p>
        <p style="color:var(--mute);font-size:0.85rem;margin:0.25rem 0 0;">Après confirmation</p>
      </div>
      <div>
        <p class="display" style="font-size:1.75rem;margin:0;">Gratuit</p>
        <p style="color:var(--mute);font-size:0.85rem;margin:0.25rem 0 0;">Diagnostic et devis</p>
      </div>
    </div>
    <p style="text-align:center;color:var(--mute);font-size:0.8rem;margin-top:1rem;">Détail complet des tarifs dans nos <a href={withBase('/cgv')} style="color:var(--mute);">CGV</a>.</p>
  </section>

  <section data-reveal style="max-width:900px;margin:0 auto;padding:0 1.5rem 6rem;text-align:center;">
    <h2 class="display" style="font-size:2rem;margin:0 0 1.5rem;">Un équipement en panne ?</h2>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a href={contact.phoneHref} class="pill pill-solid">Appeler {contact.phone}</a>
      <a href={`mailto:${contact.email}`} class="pill pill-ghost-dark">Envoyer un email</a>
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      .includes-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</NikeLayout>
