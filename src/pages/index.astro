---
import { Icon } from 'astro-icon/components';
import NikeLayout from '../layouts/NikeLayout.astro';
import { heroStory, hero, contact, testimonial, social } from '../data/content';
---

<NikeLayout
  title="Accueil"
  description="Entretien et réparation mobile d'ergomètres Concept 2 et de barres olympiques en Île-de-France. Intervention sous 48h, devis gratuit."
>
  <div class="story-grid" data-story-grid>
    <div class="story-visual" data-story-visual>
      <nav class="story-rail" aria-label="Sommaire">
        {heroStory.stages.map((stage) => (
          <a href={`#story-${stage.id}`} data-story-rail={stage.id}>
            <span class="story-rail-number">{stage.number}</span>
            <span class="story-rail-label">{stage.label}</span>
          </a>
        ))}
      </nav>
      <div class="story-carousel">
        <div data-m3d-mount class="story-track"></div>
      </div>
      <div class="story-vignette" data-story-vignette></div>
    </div>

    <div class="story-content">
      {heroStory.stages.map((stage, i) => (
        <section id={`story-${stage.id}`} data-story-stage={stage.id} class="story-stage">
          <div class="story-text" data-hero-in={i === 0 ? true : undefined} data-reveal={i === 0 ? undefined : true}>
            <span class="story-eyebrow">{stage.number} — {stage.label}</span>
            {i === 0 ? (
              <h1 class="display story-heading">{stage.heading}</h1>
            ) : (
              <h2 class="display story-heading">{stage.heading}</h2>
            )}
            <p class="story-body">{stage.body}</p>
            <div class="story-points">
              {stage.points.map((p) => (
                <span class="story-point">{p}</span>
              ))}
            </div>
            {i === 0 && (
              <div class="story-ctas">
                <a href={contact.phoneHref} class="pill pill-solid">{hero.ctaPrimary}</a>
                <a href="#story-reparation" class="pill pill-ghost">{hero.ctaSecondary}</a>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
  </div>

  <section data-reveal style="max-width:900px;margin:0 auto;padding:6rem 1.5rem;text-align:center;">
    <h2 class="display" style="font-size:2.25rem;margin:0 0 1rem;">Ce que nos clients en disent</h2>
    {testimonial.pending ? (
      <p style="color:var(--mute);font-size:1.05rem;">Nos premiers avis arrivent bientôt. Découvrez notre fiche Google en attendant.</p>
    ) : (
      <blockquote style="font-size:1.35rem;line-height:1.5;">"{testimonial.quote}"<footer style="margin-top:1rem;font-size:0.95rem;color:var(--mute);">{testimonial.author}</footer></blockquote>
    )}
    <a href={social.googleReview} class="pill pill-ghost-dark" style="margin-top:1.5rem;">
      <Icon name="ph:star" style="width:1rem;height:1rem;" aria-hidden="true" />
      Voir la fiche Google
    </a>
  </section>

  <section style="position:relative;padding:6rem 1.5rem;background:var(--ink);">
    <div data-reveal style="position:relative;max-width:1400px;margin:0 auto;text-align:center;color:#fff;">
      <h2 class="display" style="font-size:clamp(2rem,5vw,3.5rem);margin:0 0 1.5rem;">Prêt à passer à l'action ?</h2>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href={contact.phoneHref} class="pill pill-solid" style="background:#fff;color:var(--ink);">Appeler {contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="pill pill-ghost">Envoyer un email</a>
      </div>
    </div>
  </section>

  <section style="background:var(--soft);padding:5rem 1.5rem;" data-ig-section>
    <div style="max-width:1400px;margin:0 auto;text-align:center;">
      <span style="display:inline-block;font-size:0.8rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--mute);margin-bottom:0.75rem;">Suivez nos interventions</span>
      <h2 class="display" style="font-size:clamp(1.75rem,4vw,2.5rem);margin:0 0 2.5rem;">Nos dernières publications</h2>
      <div data-ig-mount style="max-width:1000px;margin:0 auto;border-radius:4px;overflow:hidden;"></div>
      <a href={social.instagram} target="_blank" rel="noopener" class="pill pill-ghost-dark" style="margin-top:2rem;">
        <Icon name="ph:instagram-logo" style="width:1rem;height:1rem;" aria-hidden="true" />
        Suivre sur Instagram
      </a>
    </div>
  </section>

  <style is:global>
    .story-grid {
      display: grid;
    }
    .story-visual, .story-content {
      grid-column: 1;
      grid-row: 1;
    }
    .story-visual {
      position: sticky;
      top: 0;
      height: 100dvh;
      overflow: hidden;
      background: #060606;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      transition: background-color 0.4s ease;
      z-index: 0;
    }
    .story-carousel {
      width: min(48vw, 480px);
      aspect-ratio: 1 / 1;
      margin-right: 3vw;
      overflow: hidden;
      position: relative;
    }
    .story-track {
      position: relative;
      width: 100%;
      height: 100%;
    }
    .story-panel {
      position: absolute;
      inset: 0;
      opacity: 0;
      will-change: opacity;
    }
    .story-panel model-viewer, .story-track > model-viewer {
      width: 100%;
      height: 100%;
    }
    .story-vignette {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
    }
    .story-rail {
      position: absolute;
      top: 6.5rem;
      left: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      z-index: 1;
    }
    .story-rail a {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      text-decoration: none;
      color: rgba(255,255,255,0.45);
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border-left: 2px solid rgba(255,255,255,0.2);
      padding-left: 0.85rem;
      transition: color 0.3s ease, border-color 0.3s ease;
    }
    .story-rail a[data-active] {
      color: #fff;
      border-color: #fff;
    }
    .story-content {
      position: relative;
      z-index: 1;
      pointer-events: none;
    }
    .story-text {
      pointer-events: auto;
    }
    .story-stage {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 6rem 1.5rem;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      box-sizing: border-box;
    }
    .story-text {
      max-width: 46ch;
      color: #fff;
    }
    .story-eyebrow {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.6);
      margin-bottom: 0.75rem;
    }
    .story-heading {
      font-size: clamp(2rem, 4.5vw, 3.25rem);
      margin: 0 0 1rem;
    }
    .story-body {
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(255,255,255,0.85);
      margin: 0 0 1.5rem;
    }
    .story-points {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1.75rem;
    }
    .story-point {
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 999px;
      padding: 0.5rem 1.1rem;
      font-size: 0.85rem;
      font-weight: 500;
    }
    .story-ctas {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    @media (min-width: 1025px) {
      .story-stage { padding-left: 13rem; padding-right: 2rem; }
      .story-text { margin-top: 5rem; }
    }
    @media (max-width: 1024px) {
      .story-grid { display: block; }
      .story-visual { position: static; height: 62vh; justify-content: center; }
      .story-carousel { width: 80vw; margin-right: 0; }
      .story-rail { display: none; }
      .story-content { background: var(--ink); }
      .story-stage { min-height: auto; padding: 3.5rem 1.5rem; justify-content: flex-start !important; }
    }
  </style>
  <script>import '../scripts/hero-story';</script>
  <script>import '../scripts/instagram-feed';</script>
</NikeLayout>
